
# Neon: usa el formato JDBC -> jdbc:postgresql://<host>.neon.tech/<base>?sslmode=require
DB_URL=
DB_USER=
DB_PASSWORD=

# Cadena aleatoria de al menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRACION_HORAS=8

# Orígenes permitidos separados por coma (ej. http://localhost:*,https://tu-front.vercel.app).
# Si se deja vacío se permite http://localhost:*
CORS_ORIGENES=
PORT=8080

# Administrador inicial (opcional). Déjalos vacíos si no quieres crearlo automáticamente.
ADMIN_CORREO=
ADMIN_PASSWORD=
